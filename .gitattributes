# Normalize line endings: git stores LF, checks out native per-platform
* text=auto

# Docs & config - always LF in the repo
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# PowerShell - CRLF (Windows PowerShell 5.1 tooling expects it)
*.ps1         text eol=crlf
*.psm1        text eol=crlf
*.psd1        text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binaries - never touch
*.png         binary
*.jpg         binary
*.ico         binary
*.pfx         binary
*.dll         binary
*.zip         binary
*.nupkg       binary
