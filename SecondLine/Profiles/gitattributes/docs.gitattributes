# Normalize line endings: git stores LF, checks out native per-platform
* text=auto

# Docs & config - always LF in the repo
*.md           text eol=lf
*.txt          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows scripts - CRLF (Windows PowerShell 5.1 and cmd.exe expect it)
*.ps1          text eol=crlf
*.psm1         text eol=crlf
*.psd1         text eol=crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Binaries - never touch
*.png          binary
*.jpg          binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.zip          binary
